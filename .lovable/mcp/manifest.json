{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "poshplex-mcp",
      "version": "0.2.0",
      "title": "POSHPLEX MCP (Full Access)"
    },
    "tools": [
      {
        "name": "list_products",
        "title": "List products",
        "description": "List active POSHPLEX products with images, variants, category, and brand. Supports pagination and optional category slug filter.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Max products (default 50)"
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "description": "Pagination offset (default 0)"
            },
            "category_slug": {
              "type": "string",
              "description": "Filter by category slug"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_product",
        "title": "Get product",
        "description": "Get a single POSHPLEX product by its UUID, including all images and variants.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "description": "Product UUID"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_categories",
        "title": "List categories",
        "description": "List all active POSHPLEX product categories with their slugs.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "db_select",
        "title": "Read rows from any table",
        "description": "Read rows from any table in the POSHPLEX database. Supports select columns, equality/IN filters, order, and range. No auth required for reads.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "table": {
              "type": "string",
              "description": "Table name (e.g. 'products', 'orders', 'customers')."
            },
            "select": {
              "type": "string",
              "description": "PostgREST select string. Default '*'. Can include joins like '*,category:categories(name,slug)'."
            },
            "filters": {
              "type": "object",
              "additionalProperties": {},
              "description": "Object of column => value (equality) or column => array (IN). null matches IS NULL."
            },
            "order_by": {
              "type": "string",
              "description": "Column to order by."
            },
            "ascending": {
              "type": "boolean",
              "description": "Ascending order (default false)."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "description": "Max rows (default 50)."
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "description": "Pagination offset (default 0)."
            }
          },
          "required": [
            "table"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "db_insert",
        "title": "Insert rows into any table",
        "description": "Insert one or many rows into any POSHPLEX table (products, categories, orders, inventory, etc). Returns inserted rows.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "api_key": {
              "type": "string",
              "description": "MCP_ADMIN_KEY."
            },
            "table": {
              "type": "string",
              "description": "Target table."
            },
            "rows": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": {}
                },
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": {}
                  }
                }
              ],
              "description": "Single row object or array of row objects."
            },
            "returning": {
              "type": "string",
              "description": "PostgREST select for returned rows (default '*')."
            }
          },
          "required": [
            "api_key",
            "table",
            "rows"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "db_update",
        "title": "Update rows in any table",
        "description": "Update rows matching filters in any POSHPLEX table. Requires filters — refuses to run without them to prevent full-table updates.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "api_key": {
              "type": "string",
              "description": "MCP_ADMIN_KEY."
            },
            "table": {
              "type": "string",
              "description": "Target table."
            },
            "values": {
              "type": "object",
              "additionalProperties": {},
              "description": "Column => new value updates."
            },
            "filters": {
              "type": "object",
              "additionalProperties": {},
              "description": "Filters (equality / IN) — REQUIRED. Prevents accidental full-table updates."
            },
            "returning": {
              "type": "string",
              "description": "PostgREST select for returned rows (default '*')."
            }
          },
          "required": [
            "api_key",
            "table",
            "values",
            "filters"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "db_delete",
        "title": "Delete rows from any table",
        "description": "Delete rows matching filters in any POSHPLEX table. Requires filters — refuses to run without them to prevent full-table deletes.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "api_key": {
              "type": "string",
              "description": "MCP_ADMIN_KEY."
            },
            "table": {
              "type": "string",
              "description": "Target table."
            },
            "filters": {
              "type": "object",
              "additionalProperties": {},
              "description": "Filters (equality / IN) — REQUIRED. Prevents accidental full-table deletes."
            },
            "returning": {
              "type": "string",
              "description": "PostgREST select for returned rows (default 'id')."
            }
          },
          "required": [
            "api_key",
            "table",
            "filters"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "db_rpc",
        "title": "Call a database function",
        "description": "Invoke a Postgres function (RPC) in the public schema — e.g. create_order_atomic, record_order_payment_atomic, upsert_checkout_customer, track_orders_lookup.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "api_key": {
              "type": "string",
              "description": "MCP_ADMIN_KEY."
            },
            "function": {
              "type": "string",
              "description": "Function name."
            },
            "args": {
              "type": "object",
              "additionalProperties": {},
              "description": "Named arguments object."
            }
          },
          "required": [
            "api_key",
            "function"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "storage_upload_from_url",
        "title": "Upload image from URL to storage",
        "description": "Download a remote file and upload it to a Supabase storage bucket. Returns the public URL. Typical use: upload product images by URL.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "api_key": {
              "type": "string",
              "description": "MCP_ADMIN_KEY."
            },
            "bucket": {
              "type": "string",
              "description": "Storage bucket (e.g. 'product-images', 'media', 'review-images')."
            },
            "source_url": {
              "type": "string",
              "format": "uri",
              "description": "Public URL to fetch bytes from."
            },
            "path": {
              "type": "string",
              "description": "Destination path inside the bucket (e.g. 'imports/2026/shirt-red.jpg')."
            },
            "content_type": {
              "type": "string",
              "description": "Override MIME type (default: from Content-Type header)."
            },
            "upsert": {
              "type": "boolean",
              "description": "Overwrite if the path exists (default false)."
            }
          },
          "required": [
            "api_key",
            "bucket",
            "source_url",
            "path"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "schema_describe",
        "title": "Describe database schema",
        "description": "List tables in the public schema, or return columns for a specific table (name, type, nullable, default). Use this to discover the shape of the database before calling db_insert/update.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "table": {
              "type": "string",
              "description": "Optional table name. Omit to list all tables."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
